{
  "name": "Projeto Forecast",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#6250d6",
    "#e34948"
  ],
  "background": "#ffffff",
  "foreground": "#0b0b0b",
  "foregroundNeutralSecondary": "#52514e",
  "foregroundNeutralTertiary": "#8a8984",
  "backgroundLight": "#f3f2ef",
  "backgroundNeutral": "#e4e3df",
  "tableAccent": "#2a78d6",
  "hyperlink": "#256abf",
  "visitedHyperlink": "#6250d6",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#1c5cab",
  "center": "#f0efec",
  "minimum": "#c23a3a",
  "null": "#d6d5d0",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#52514e" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#ffffff" } }, "transparency": 0 }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "visualHeader": [{ "show": true }],
        "valueAxis": [{ "gridlineShow": true, "gridlineColor": { "solid": { "color": "#e4e3df" } }, "gridlineThickness": 1 }],
        "categoryAxis": [{ "gridlineShow": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#f3f2ef" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#f3f2ef" } } }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2, "showMarker": true, "markerSize": 4 }]
      }
    }
  }
}
